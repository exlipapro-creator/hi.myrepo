  {
    "code": "RB-03",
    "name": "Dependency Failover",
    "description": "Switch to a backup dependency when the primary is unhealthy.",
    "status": "ACTIVE",
    "preconditions": {
      "backup_dependency_configured": true,
      "primary_dependency_unhealthy": true
    },
    "authorization_requirements": {
      "min_autonomy_level": 3,
      "requires_approval": true
    },
    "execution_steps": [
