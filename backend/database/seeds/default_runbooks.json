[
  {
    "code": "RB-01",
    "name": "Service Restart",
    "description": "Restart a service to recover from transient failures. Low risk, commonly reversible.",
    "status": "ACTIVE",
    "preconditions": {
      "service_must_be_running": true,
      "transient_failure_confirmed": true
    },
    "authorization_requirements": {
      "min_autonomy_level": 2,
      "requires_approval": true
    },
    "execution_steps": [
      {"step": 1, "action": "stop_service", "description": "Gracefully stop the target service"},
      {"step": 2, "action": "wait", "duration_seconds": 5, "description": "Wait for graceful shutdown"},
      {"step": 3, "action": "start_service", "description": "Start the target service"},
      {"step": 4, "action": "health_check", "description": "Verify service is responding to health checks"},
      {"step": 5, "action": "observe_error_rate", "duration_seconds": 60, "description": "Monitor error rate for 60 seconds"}
    ],
    "rollback_strategy": "Service was already running before; no rollback needed.",
    "verification_procedure": {
      "type": "health_check",
      "required_consecutive_passes": 3,
      "check_interval_seconds": 10,
      "max_verification_duration_seconds": 120
    },
    "timeout_seconds": 300,
    "max_blast_radius": "low",
    "is_reversible": true,
    "required_autonomy_level": 2
  },
  {
