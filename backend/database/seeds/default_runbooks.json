      {"step": 2, "action": "switch_traffic", "description": "Route traffic to backup dependency"},
      {"step": 3, "action": "health_check", "description": "Verify service health after failover"}
    ],
    "rollback_strategy": "Switch traffic back to primary when it recovers.",
    "verification_procedure": {
      "type": "health_check",
      "required_consecutive_passes": 5,
      "check_interval_seconds": 10
    },
    "timeout_seconds": 180,
    "max_blast_radius": "medium",
    "is_reversible": true,
    "required_autonomy_level": 3
  },
  {
    "code": "RB-04",
    "name": "Automated Deployment Rollback",
    "description": "Rollback a deployment when a regression is detected with high confidence.",
    "status": "ACTIVE",
    "preconditions": {
      "deployment_regression_detected": true,
      "rollback_target_available": true
    },
    "authorization_requirements": {
      "min_autonomy_level": 4,
      "requires_approval": true,
      "conditions": {
        "confidence": {"op": "gte", "value": 0.85},
        "blast_radius": {"op": "in", "value": ["low", "medium"]}
      }
    },
    "execution_steps": [
      {"step": 1, "action": "snapshot_current", "description": "Snapshot current state for forensic analysis"},
      {"step": 2, "action": "rollback_deployment", "description": "Execute deployment rollback"},
      {"step": 3, "action": "wait", "duration_seconds": 30, "description": "Wait for rollback to propagate"},
      {"step": 4, "action": "health_check", "description": "Verify service health post-rollback"},
      {"step": 5, "action": "observe_error_rate", "duration_seconds": 120, "description": "Monitor error rate for 120 seconds"},
      {"step": 6, "action": "compare_metrics", "description": "Compare pre/post rollback metrics"}
    ],
    "rollback_strategy": "Re-deploy the rolled-back version if rollback itself causes issues.",
    "verification_procedure": {
      "type": "health_check",
      "required_consecutive_passes": 3,
      "check_interval_seconds": 15,
      "max_verification_duration_seconds": 300
    },
    "timeout_seconds": 600,
    "max_blast_radius": "medium",
    "is_reversible": true,
    "required_autonomy_level": 4
  },
  {
