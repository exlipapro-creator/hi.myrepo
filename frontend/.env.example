# ============================================================================
# hi.myrepo Frontend — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================================

# Backend API URL
# Leave empty for local development (Vite proxy handles /api and /v1 routes)
# Set to your Railway backend URL for production:
# VITE_API_BASE_URL=https://your-app.up.railway.app
VITE_API_BASE_URL=
